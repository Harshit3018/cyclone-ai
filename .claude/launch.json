{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "backend.app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "frontend-attach",
      "url": "http://localhost:5173",
      "port": 5173
    },
    {
      "name": "fullstack",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "backend.app.main:app", "--port", "8001"],
      "port": 8001
    }
  ]
}
