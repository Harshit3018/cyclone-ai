# CYCLONE-AI Environment Configuration
# Copy this file to .env and fill in values

# Application
APP_ENV=demo  # demo | development | production
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./cyclone_ai.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/cyclone_ai
# POSTGRES_USER=cyclone_ai
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=cyclone_ai

# Model paths
MODEL_PATH=models/checkpoints
DATA_PATH=data

# External data sources (optional - not required for demo mode)
IMD_API_KEY=your_imd_api_key_here
# NASA_EARTHDATA_USERNAME=
# NASA_EARTHDATA_PASSWORD=
# CDS_API_KEY=  # Copernicus Climate Data Store (ERA5)
# MOSDAC_USERNAME=
# MOSDAC_PASSWORD=

# Redis (optional)
# REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO
